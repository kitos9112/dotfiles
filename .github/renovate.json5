{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    ':enableRenovate',
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    ':separatePatchReleases',
    ':enableVulnerabilityAlerts',
    'docker:enableMajor',
    ':enablePreCommit',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Europe/London',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate Dashboard',
  // Hold routine updates long enough for compromised releases to be detected
  // or withdrawn. Security alerts still open immediately for manual review.
  minimumReleaseAge: '14 days',
  internalChecksFilter: 'strict',
  labels: [
    'renovatebot',
  ],
  gitAuthor: 'henry-pa-bot <166536+henry-bot[bot]@users.noreply.github.com>',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  // GitHub requires the stable Acceptance Gate check. Other informational or
  // cosmetic checks do not prevent an otherwise safe dependency update.
  ignoreTests: false,
  platformAutomerge: true,
  rebaseWhen: 'auto',
  assignees: [
    '@kitos9112',
  ],
  customManagers: [
    {
      customType: 'regex',
      datasourceTemplate: 'docker',
      description: 'Track the pinned local Renovate image',
      managerFilePatterns: [
        '/^Taskfile\.yaml$/',
      ],
      matchStrings: [
        'RENOVATE_IMAGE:\\s*"(?<depName>renovate/renovate):(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
    },
    {
      customType: 'regex',
      datasourceTemplate: 'git-refs',
      depNameTemplate: 'Homebrew/install',
      packageNameTemplate: 'https://github.com/Homebrew/install',
      description: 'Track the pinned Homebrew installer commit against its default branch',
      currentValueTemplate: 'main',
      managerFilePatterns: [
        '/^home/\\.chezmoiscripts/.*install-brew-packages\\.(sh|zsh)\\.tmpl$/',
      ],
      matchStrings: [
        'raw\\.githubusercontent\\.com/Homebrew/install/(?<currentDigest>[0-9a-f]{40})/install\\.sh',
      ],
    },
    {
      customType: 'regex',
      description: 'Process renovate comments in home templates',
      managerFilePatterns: [
        '/^home\\/.*/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.+?) packageName=(?<packageName>.+?)( extractVersion=(?<extractVersion>.+?))?( registryUrl=(?<registryUrl>.+?))?\\s+(?<depName>.+?) (?<currentValue>.+)',
      ],
      extractVersionTemplate: '{{#if extractVersion}}{{extractVersion}}{{else}}^v?(?<version>.+)${{/if}}',
    },
  ],
  vulnerabilityAlerts: {
    // Do not delay known vulnerability fixes, but keep a human in the loop.
    minimumReleaseAge: null,
    automerge: false,
    labels: [
      'renovatebot',
      'security',
    ],
  },
  packageRules: [
    {
      description: 'Keep Go tool dependency checksums complete after updates',
      matchManagers: [
        'gomod',
      ],
      postUpdateOptions: [
        'gomodTidy',
      ],
    },
    {
      matchPackageNames: [
        'node',
        'python',
      ],
      minimumReleaseAge: '20 days',
    },
    {
      description: 'Automerge aged routine updates after required CI passes',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      description: 'Never automerge majors or pin operations',
      matchUpdateTypes: [
        'major',
        'pin',
      ],
      automerge: false,
    },
    {
      description: 'Batch Renovate self-updates into one weekly pull request',
      matchDepNames: [
        'renovate/renovate',
        'renovatebot/pre-commit-hooks',
      ],
      groupName: 'renovate',
      separateMinorPatch: false,
      schedule: [
        '* * * * 1',
      ],
    },
    {
      description: 'Review the curl-piped Homebrew installer by hand once a month',
      matchDepNames: [
        'Homebrew/install',
      ],
      // git-refs digests have no release timestamp to age against.
      minimumReleaseAge: null,
      schedule: [
        '* * 1 * *',
      ],
      automerge: false,
    },
  ],
  asdf: {
    managerFilePatterns: [
      '/(^|/)\\.tool-versions$/',
      '/(^|/)dot_tool-versions.tmpl$/',
    ],
  },
}
