# The following variables are only available within this TOML template file

{{ $personalName := "Marcos Soutullo Rodriguez" -}}
{{- $personalEmail := "marcos.soutullo91@gmail.com" -}}
{{- $personalSigningKey := "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHJQ/v90Djih+2baccSLZnFPhP9FHpIoNzqDPsJhLgCs" -}}
{{- $githubUsername := "kitos9112" -}}

{{- $isWsl := or (env "WSL_DISTRO_NAME") (env "IS_WSL") | not | not -}}

{{- /* machine_class decides whether GUI-only components (1Password app, Ghostty,
       Nerd Fonts, GNOME settings) are installed. The detection logic lives in
       .chezmoitemplates/machine-class so scripts resolve it identically. */ -}}
{{- $machineClass := includeTemplate "machine-class" . | trim -}}

{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- $isWork := false -}}
{{- $isWorkOverride := env "DOTFILES_IS_WORK" -}}
{{- if eq $isWorkOverride "true" -}}
{{-   $isWork = true -}}
{{- else if eq $isWorkOverride "false" -}}
{{-   $isWork = false -}}
{{- else if hasKey . "is_work" -}}
{{-   $isWork = .is_work -}}
{{- else if stdinIsATTY -}}
{{-   $isWork = promptBool "Is this a work machine?" -}}
{{- end -}}

{{- /* Whether sudo may be used to install system packages. Detection lives in
       .chezmoitemplates/is-root so the install scripts resolve it identically.
       Work machines default to no sudo, but many do grant it, so ask once and
       persist the answer instead of requiring DOTFILES_IS_ROOT on every run. */ -}}
{{- /* is_work is still a local variable at this point, not yet part of the
       template data, so it has to be passed in explicitly: otherwise the shared
       template sees no work flag and a non-interactive work machine wrongly
       resolves to sudo-capable. is_root is forwarded only when a previous init
       persisted it, so the template can still tell "persisted" from "unset". */ -}}
{{- $rootCtx := dict "is_work" $isWork -}}
{{- if hasKey . "is_root" -}}
{{-   $_ := set $rootCtx "is_root" .is_root -}}
{{- end -}}
{{- $isRoot := eq (includeTemplate "is-root" $rootCtx) "true" -}}
{{- if and (not (env "DOTFILES_IS_ROOT")) (not (hasKey . "is_root")) stdinIsATTY -}}
{{-   $isRoot = promptBool "Can this machine use sudo (to install apt and other system packages)?" $isRoot -}}
{{- end -}}

{{- /* Whether Homebrew is used here. Independent of sudo on purpose: a work
       machine can have sudo for apt and still have no reason to run linuxbrew.
       macOS always uses it; Linux is opt-in and remembers the answer. */ -}}
{{- $useHomebrew := eq (includeTemplate "use-homebrew" .) "true" -}}
{{- if and (ne .chezmoi.os "darwin") (not (env "DOTFILES_HOMEBREW")) (not (hasKey . "use_homebrew")) stdinIsATTY -}}
{{-   $useHomebrew = promptBool "Install and use Homebrew on this machine?" $useHomebrew -}}
{{- end -}}

{{- $workEmail := "" -}}
{{- $workName := "" -}}
{{- $workGitdir := "" -}}
{{- if $isWork -}}
{{-   $workEmail  = get . "work_email"  | default "" -}}
{{-   $workName   = get . "work_name"   | default "" -}}
{{-   $workGitdir = get . "work_gitdir" | default "" -}}
{{-   if stdinIsATTY -}}
{{-     $workEmail  = promptStringOnce . "work_email"  "Work email" -}}
{{-     $workName   = promptStringOnce . "work_name"   "Work display name" -}}
{{-     $workGitdir = promptStringOnce . "work_gitdir" "Work git directory (e.g. ~/workspace/transficc/)" -}}
{{-   end -}}
{{- end -}}

sourceDir = "{{ .chezmoi.sourceDir }}"
progress = true

[data]
  # Here we "export" the variables, so we can access them outside this file
  osid = {{ $osid | quote }}
  is_wsl = {{ $isWsl }}
  machine_class = {{ $machineClass | quote }} # "desktop" (GUI present) or "server" (CLI only)

  personal_name = "{{ $personalName }}"
  personal_email = "{{ $personalEmail }}"
  github_username = "{{ $githubUsername }}"

  is_root = {{ $isRoot }} # Whether sudo may be used for system packages (apt, dnf)
  use_homebrew = {{ $useHomebrew }} # Whether Homebrew is used here; independent of sudo
  is_work = {{ $isWork }} # Whether or not this is my work laptop
  work_email  = {{ $workEmail | quote }}
  work_name   = {{ $workName | quote }}
  work_gitdir = {{ $workGitdir | quote }}

  name = "{{ $personalName }}"
  {{- if not $isWork }}
  email = "{{ $personalEmail }}"
  {{- end }}

  signing_key = "{{ $personalSigningKey }}"
  signing_format = "ssh" # https://developer.1password.com/docs/ssh/git-commit-signing#advanced-configuration
  {{ if eq .chezmoi.os "darwin" }}
  signing_ssh_program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  {{ else if eq .chezmoi.os "linux" }}
  signing_ssh_program = "/opt/1Password/op-ssh-sign"
  {{ end }}

  {{- if or (lookPath "code") }}
  editor = "code --wait --diff $LOCAL $REMOTE"
  {{- else if lookPath "vim" }}
  editor = "vim"
  {{- else if lookPath "nano" }}
  editor = "nano"
  {{- else }}
  editor = "vi"
  {{- end }}

  # locale lives in .chezmoidata/locale.yaml: it is a static constant, and keeping
  # it here made it invisible to anything rendering from the source tree alone.
  uname_arch = "{{ output "uname" "-m" | trim }}"

[sourceVCS]
  autoCommit = true

[onepassword]
  prompt = true

[edit]
  command = "code"
  args = ["--wait"]

[warnings]
  configFileTemplateHasChanged = false
