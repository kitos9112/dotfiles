{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#! /usr/bin/env bash
{{ includeTemplate "scripts-library" . }}

# Generate ~/.fzf.zsh and ~/.fzf.bash, which dot_zshrc and dot_bashrc source.
#
# This has to run in the `after` stage: the ~/.fzf checkout is a chezmoi external,
# and externals are only materialised while target state is applied. The previous
# home for this step was the Homebrew script in the `before` stage, so on a first
# bootstrap ~/.fzf did not exist yet, and on machines without sudo it never ran at
# all. A second run only appeared to work because the external had landed during
# the first pass.

FZF_DIR="${HOME}/.fzf"
BREW_FZF="/home/linuxbrew/.linuxbrew/opt/fzf/install"

# --no-update-rc: the shell rc files are managed by chezmoi, so the installer must
# not append its own sourcing lines to them.
if [[ -x "${FZF_DIR}/install" ]]; then
  log_task "Configuring fzf shell integration from ${FZF_DIR}"
  "${FZF_DIR}/install" --key-bindings --completion --no-update-rc
elif [[ -x "${BREW_FZF}" ]]; then
  log_task "Configuring fzf shell integration from Homebrew"
  "${BREW_FZF}" --key-bindings --completion --no-update-rc
else
  # Not fatal: both rc files guard their fzf sourcing with an existence check.
  log_info "fzf is not installed yet; skipping shell integration"
  exit 0
fi

for rc in "${HOME}/.fzf.zsh" "${HOME}/.fzf.bash"; do
  if [[ -r "${rc}" ]]; then
    log_green "$(basename "${rc}") is ready"
  else
    log_manual_action "$(basename "${rc}") was not generated; check the fzf installer output"
  fi
done
{{- end -}}
