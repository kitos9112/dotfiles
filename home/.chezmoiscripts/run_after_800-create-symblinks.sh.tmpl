{{- $extraHomeDir := get . "extra_home_dir" | default "" -}}
{{- if and (eq .chezmoi.os "linux") $extraHomeDir -}}
#!/usr/bin/env bash

set -ev -o pipefail

paths=".bashrc .fzf .fzf.bash .fzf.zsh .gitconfig .oh-my-zsh-custom .p10k.zsh .tmux.conf.local .tmux.conf .vimrc .zshrc"
EXTRA_HOME_DIR={{ shellQuote $extraHomeDir }}

# Create an array with paths (files or directories)
IFS=' ' read -ra path_array <<< "$paths"

# Loop through the paths and create a symbolic link in each target directory.
# Missing entries are skipped rather than fatal: realpath on an absent path exits
# non-zero, which under `set -e` aborted the whole apply. On a first bootstrap
# some of these (notably .fzf.zsh and .fzf.bash) are generated by earlier steps
# that may legitimately have been skipped.
for path in "${path_array[@]}"; do
  if [[ ! -e "$HOME/$path" ]]; then
    echo "Skipping $HOME/$path: not present"
    continue
  fi

  resolved="$(realpath "$HOME/$path")"
  rsync -uL --exclude "*.git*" --exclude "${resolved}/.git" "${resolved}" "${EXTRA_HOME_DIR}/$(basename "$path")"
done
{{ end -}}
