{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env zsh

set -ev -o pipefail

# 5. Update and upgrade brew packages
ASDF="${HOME}/.local/bin/asdf"
PATH_old="${PATH}"

# FIXME(WA): This is a hack to make sure that `asdf` and `brew` is in the path
export PATH="${HOME}/.local/bin:${HOME}/.asdf/shims:${PATH}"

{{ if eq (includeTemplate "use-homebrew" . | trim) "true" -}}
# `brew --prefix` was expanded unguarded and prefixed with $HOME, which both
# produced a bogus PATH entry and aborted the apply under `set -e` whenever brew
# was not yet on PATH — exactly the case on a first bootstrap.
if command -v brew >/dev/null 2>&1; then
  export PATH="$(brew --prefix)/bin:${PATH}"
  brew update && brew upgrade || echo "brew update/upgrade did not complete; continuing"
else
  echo "brew is not on PATH; skipping update"
fi
{{ end -}}

# asdf itself arrives as a chezmoi external, so on a first pass it may not exist
# yet. None of the steps below is a prerequisite for the rest of the dotfiles.
if [[ ! -x "${ASDF}" ]]; then
  echo "asdf is not installed yet; skipping plugin and tool updates"
  export PATH="${PATH_old}"
  exit 0
fi

# 6. Update all ASDF plugins
${ASDF} plugin update --all || echo "Could not update every ASDF plugin; continuing"

# 7. Install/update all ASDF package versions using libraries installed by brew
${ASDF} install || echo "Some ASDF tool versions failed to install; continuing"

export PATH="${PATH_old}"
{{ end -}}
