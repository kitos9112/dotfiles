{{- if eq .chezmoi.os "linux" -}}
{{- $machineClass := includeTemplate "machine-class" . | trim -}}
#! /usr/bin/env bash
{{ includeTemplate "scripts-library" . }}

# Bring 1Password up on a fresh machine. Desktop machines sign in through the
# app (QR setup code from the mobile app); servers have no app, so the CLI
# handles it. Either way this script must never block or fail an unattended
# apply: without a TTY it prints how to finish and exits 0.

MACHINE_CLASS="{{ $machineClass }}"
SIGNIN_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=5

function op_is_configured() {
  # `op account list` exits 0 with empty output when no account is known.
  command -v op >/dev/null 2>&1 && [[ -n "$(op account list 2>/dev/null)" ]]
}

if [[ "${DOTFILES_TEST:-}" == true ]]; then
  log_info "Skipping 1Password sign-in in test mode"
  exit 0
fi

if ! command -v op >/dev/null 2>&1; then
  log_info "1Password CLI is not installed; skipping sign-in"
  exit 0
fi

if op_is_configured; then
  log_green "1Password is already configured for this user"
  exit 0
fi

if [[ ! -t 0 ]]; then
  log_info "No TTY available, so 1Password sign-in is deferred."
  if [[ "${MACHINE_CLASS}" == "desktop" ]]; then
    log_c "Open the 1Password app, sign in, then enable Settings > Developer > 'Integrate with 1Password CLI'"
  else
    log_c "Run: op account add"
  fi
  exit 0
fi

if [[ "${MACHINE_CLASS}" == "desktop" ]]; then
  log_task "Starting the 1Password desktop app for first-time sign-in"

  if command -v 1password >/dev/null 2>&1; then
    nohup 1password >/dev/null 2>&1 &
    disown || true
  else
    log_manual_action "The 1Password app is not installed; start it manually once available"
  fi

  log_manual_action "Finish sign-in in the 1Password window:"
  log_c "  1. On your phone, open 1Password and go to Settings to display this account's setup (QR) code."
  log_c "  2. In the desktop app, choose the QR / 'scan setup code' sign-in option and scan or display the code as prompted."
  log_c "  3. Once unlocked, enable Settings > Developer > 'Integrate with 1Password CLI' so 'op' can use the app."
  log_c "  Reference: https://support.1password.com/get-started-linux/"

  log_task "Waiting up to ${SIGNIN_TIMEOUT_SECONDS}s for the CLI to see an account"
  deadline=$((SECONDS + SIGNIN_TIMEOUT_SECONDS))
  while ((SECONDS < deadline)); do
    if op_is_configured; then
      log_green "1Password CLI is now connected to the desktop app"
      exit 0
    fi
    sleep "${POLL_INTERVAL_SECONDS}"
  done

  log_manual_action "Timed out waiting for 1Password. Finish in the app, then verify with: op account list"
  exit 0
fi

log_task "Adding a 1Password account to the CLI (server profile)"
log_info "You need your sign-in address, email, secret key and account password."
log_info "Find them on a signed-in device under 1Password > Settings > Accounts."

if op account add; then
  log_green "1Password account added; unlock this shell with: eval \"\$(op signin)\""
else
  log_manual_action "'op account add' did not complete. Re-run it manually when ready."
fi
{{- end -}}
