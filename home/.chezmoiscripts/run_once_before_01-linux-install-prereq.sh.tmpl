
{{- if (eq .chezmoi.os "linux") -}}
#! /usr/bin/env bash
set -ev -o pipefail
set +x
# Assess whether this is an ubuntu or debian system and check is the root flag is set
{{ if eq (includeTemplate "is-root" . | trim) "true" -}}
{{ if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") -}}

# Package installation lives in run_onchange_before_03-linux-apt-packages, which
# is driven by .chezmoidata/packages.yaml so list edits reach existing machines.
# Only the one-time distribution upgrade stays here.
DEBIAN_FRONTEND=noninteractive sudo -E apt update
DEBIAN_FRONTEND=noninteractive sudo -E apt upgrade -y

{{ end -}}
{{- if (eq .chezmoi.osRelease.id "rhel") -}}
sudo -E yum update -y
sudo -E yum install -y \
              curl \
              file \
              git \
              jq \
              vim
{{ end -}}
{{- end -}}
{{- end -}}
