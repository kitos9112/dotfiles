
{{- if (eq .chezmoi.os "linux") -}}
#! /usr/bin/env bash
set -ev -o pipefail
set +x
# Assess whether this is an ubuntu or debian system and check is the root flag is set
{{ if .is_root -}}
{{ if or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") -}}

# Package installation lives in run_onchange_before_03-linux-apt-packages, which
# is driven by .chezmoidata/packages.yaml so list edits reach existing machines.
# Only the one-time distribution upgrade stays here.
DEBIAN_FRONTEND=noninteractive sudo -E apt update
DEBIAN_FRONTEND=noninteractive sudo -E apt upgrade -y

{{ end -}}
{{- if (eq .chezmoi.osRelease.id "rhel") -}}
sudo -E yum update -y
sudo -E yum install -y \
              curl \
              file \
              git \
              jq \
              vim
{{ end -}}
{{- if or (eq .chezmoi.osRelease.id "fedora") (eq .chezmoi.osRelease.id "almalinux") -}}
sudo -E dnf update -y
sudo -E dnf install -y \
              1password \
              1password-cli \
              curl \
              file \
              git \
              jq \
              vim \
              util-linux-user \
              libxcrypt-compat \
              zsh \
              unzip \
              python \
              gcc \
              tmux \
              make \
              zlib-devel \
              bzip2 \
              bzip2-devel \
              readline-devel \
              sqlite \
              sqlite-devel \
              openssl-devel \
              tk-devel \
              xz \
              g++ \
              patch \
              bison \
              libffi-devel \
              dnf-automatic \
              cronie \
              cronie-anacron

# Setting the System Locale
localectl set-locale LANG={{ .locale }} || echo -e "Could not set locale - Ignore if happens within Container"

# TODO - Modify `apply_updates = yes` in /etc/dnf/automatic.conf
## And `systemctl enable --now dnf-automatic.timer`
{{ end -}}
{{- end -}}
{{- end -}}
