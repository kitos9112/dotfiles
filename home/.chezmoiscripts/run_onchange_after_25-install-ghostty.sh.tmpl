{{- $machineClass := includeTemplate "machine-class" . | trim -}}
{{- if and (eq .chezmoi.os "linux") (eq (includeTemplate "is-root" . | trim) "true") (eq $machineClass "desktop") (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian")) -}}
#! /usr/bin/env bash
{{ includeTemplate "scripts-library" . }}

# Ghostty publishes no official apt repository, so this installs the community
# ghostty-ubuntu deb built for the running Ubuntu series. The asset URL is
# discovered from the GitHub release rather than constructed, so a change in
# their file-naming scheme does not silently break the install.
#
# ghostty manifest sha256: {{ .packages.ghostty | toJson | sha256sum }}

GHOSTTY_VERSION={{ .packages.ghostty.version | quote }}
GHOSTTY_TAG={{ .packages.ghostty.tag | quote }}
GHOSTTY_REPO={{ .packages.ghostty.repo | quote }}

if [[ "${DOTFILES_TEST:-}" == true ]]; then
  log_info "Skipping Ghostty installation in test mode"
  exit 0
fi

installed_version="$(dpkg-query --showformat='${Version}' --show ghostty 2>/dev/null || true)"
if [[ "${installed_version}" == "${GHOSTTY_VERSION}"* ]]; then
  log_green "Ghostty ${installed_version} is already installed"
  exit 0
fi

arch="$(dpkg --print-architecture)"
# Assets are named per distribution series: Ubuntu builds carry the numeric
# release (ghostty_..._amd64_24.04.deb) while Debian builds carry the codename
# (..._amd64_trixie.deb), so try the number first and fall back to the codename.
# shellcheck disable=SC1091
series="$(. /etc/os-release && echo "${VERSION_ID:-}")"
# shellcheck disable=SC1091
series_codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"

function find_deb_url() {
  local ref="$1"
  local match="$2"

  # `|| true` because head exits after one line and SIGPIPEs the greps upstream,
  # which pipefail would otherwise turn into a fatal error instead of "no match".
  curl --fail --silent --show-error --location \
    "https://api.github.com/repos/${GHOSTTY_REPO}/releases/${ref}" 2>/dev/null |
    grep --only-matching 'https://[^"]*\.deb' |
    grep -- "_${arch}_" |
    grep -- "_${match}\.deb" |
    head -n 1 || true
}

function find_deb_url_for_series() {
  local ref="$1"
  local url=""

  if [[ -n "${series}" ]]; then
    url="$(find_deb_url "${ref}" "${series}")"
  fi
  if [[ -z "${url}" && -n "${series_codename}" ]]; then
    url="$(find_deb_url "${ref}" "${series_codename}")"
  fi

  printf '%s' "${url}"
}

log_task "Resolving Ghostty ${GHOSTTY_VERSION} deb for ${series:-${series_codename}}/${arch}"
deb_url="$(find_deb_url_for_series "tags/${GHOSTTY_TAG}")"
if [[ -z "${deb_url}" ]]; then
  log_info "Tag ${GHOSTTY_TAG} has no matching asset; falling back to the latest release"
  deb_url="$(find_deb_url_for_series latest)"
fi

if [[ -z "${deb_url}" ]]; then
  # Ghostty is a convenience, not a prerequisite: warn and let the apply finish.
  log_manual_action "No Ghostty deb for ${series:-${series_codename}}/${arch}; install it manually from https://ghostty.org"
  exit 0
fi

workdir="$(mktemp --directory)"
trap 'rm -rf "${workdir}"' EXIT HUP INT TERM

log_task "Downloading ${deb_url}"
if ! curl --fail --silent --show-error --location --output "${workdir}/ghostty.deb" "${deb_url}"; then
  log_manual_action "Failed to download Ghostty; install it manually from https://ghostty.org"
  exit 0
fi

log_task "Installing Ghostty"
# apt-get, not dpkg, so runtime dependencies are resolved.
sudo apt-get install --yes "${workdir}/ghostty.deb"
log_green "Ghostty $(dpkg-query --showformat='${Version}' --show ghostty) installed"
{{- end -}}
