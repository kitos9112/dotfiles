
{{- if (eq .chezmoi.os "darwin") -}}
#! /usr/bin/env bash
set -ev -o pipefail

# brew manifest sha256: {{ .packages.brew | toJson | sha256sum }}

# 1. Install Homebrew
which -a brew || /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/641127e1d6a9b5fd01dd4582abe174b7a4069bba/install.sh)"
brew="/opt/homebrew/bin/brew"
$brew --version

# 2. Install Homebrew packages
## `brew bundle dump` to generate Brewfile
$brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range .packages.brew.taps | uniq | sortAlpha -}}
    tap {{ . | quote }}
{{ end -}}
{{ range .packages.brew.common | uniq | sortAlpha -}}
    brew {{ . | quote }}
{{ end -}}
    tap "1password/tap"
    tap "aquasecurity/trivy"
    tap "dty1er/tap"
    tap "gabrie30/utils"
    tap "go-task/tap"
    tap "helm/tap"
    tap "instrumenta/instrumenta"
    tap "librespeed/tap"
    brew "xz"
    brew "asdf"
    brew "openssl@3"
    brew "readline"
    brew "bash"
    brew "bzip2"
    brew "cargo-instruments"
    brew "cloc"
    brew "coreutils"
    brew "curl"
    brew "dnscrypt-proxy", restart_service: :changed
    brew "dnsmasq", restart_service: :changed
    brew "docker-compose"
    brew "expect"
    brew "findutils"
    brew "fio"
    brew "flock"
    brew "freerdp"
    brew "git"
    brew "glab"
    brew "gnu-sed"
    brew "gnu-tar"
    brew "pinentry"
    brew "gnupg"
    brew "gnuplot"
    brew "goreleaser"
    brew "librsvg"
    brew "graphviz"
    brew "grep"
    brew "htop"
    brew "hub"
    brew "hyperfine"
    brew "influxdb"
    brew "iproute2mac"
    brew "jfrog-cli"
    brew "jq"
    brew "krb5"
    brew "libedit"
    brew "libvirt"
    brew "libvncserver"
    brew "lima"
    brew "lolcat"
    brew "make"
    brew "minikube"
    brew "mockery"
    brew "net-snmp"
    brew "nmap"
    brew "node"
    brew "nspr"
    brew "nss"
    brew "openldap"
    brew "openssh"
    brew "ossp-uuid"
    brew "p7zip"
    brew "parallel"
    brew "tree"
    brew "pass"
    brew "pinentry-mac"
    cask "1password"
    cask "1password-cli"
    cask "claude-code"
    cask "codex"
    cask "ghostty"
    cask "visual-studio-code"
    cask "maccy"
EOF

