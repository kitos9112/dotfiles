# Ghostty configuration — managed by chezmoi.
# Kept deliberately close to dot_wezterm.lua so both terminals feel the same.
# Reference: https://ghostty.org/docs/config/reference

font-family = {{ .terminalFont.name }}
font-size = {{ .terminalFont.size }}

# WezTerm's Galizur scheme has no Ghostty equivalent, so no theme is pinned
# here. Pick one from `ghostty +list-themes` and add e.g. `theme = GruvboxDark`.
background-opacity = 1.0
window-padding-x = 4
window-padding-y = 2

# Matches WezTerm's scrollback budget (bytes in Ghostty, lines in WezTerm).
scrollback-limit = 100000000

window-inherit-working-directory = true
confirm-close-surface = true
copy-on-select = clipboard
shell-integration = detect
shell-integration-features = cursor,sudo,title

{{ if eq .chezmoi.os "darwin" -}}
# Left Option behaves like Meta for shell editing; right Option keeps accents.
macos-option-as-alt = left
# British keyboard: Option+3 produces #, but left Option is also used as Meta.
keybind = alt+3=text:\x23
# Quick terminal from any app; macOS asks for Accessibility access on first use.
keybind = global:ctrl+alt+shift+super+q=toggle_quick_terminal

{{ end -}}
# Commands from .chezmoidata/ghostty.yaml and the private work profile:
# ctrl+alt+shift+super+<key> types each one at the prompt, and the command
# palette lists it by title.
{{- $work := includeTemplate "work-profile" . | fromJson }}
{{- $commands := concat .ghosttyCommands (get $work "ghosttyCommands" | default list) }}
{{- $taken := dict "q" "the global quick terminal" }}
{{- range $commands }}
{{-   $key := toString .key }}
{{-   if not (regexMatch "^[a-z0-9]$" $key) }}
{{-     fail (printf "ghosttyCommands: key %q of %q must be a single a-z or 0-9" $key .title) }}
{{-   end }}
{{-   if hasKey $taken $key }}
{{-     fail (printf "ghosttyCommands: key %q of %q is already used by %s" $key .title (get $taken $key)) }}
{{-   end }}
{{-   $_ := set $taken $key .title }}
{{-   $text := printf "text:%s\\r" (.command | replace "\\" "\\\\" | replace "\"" "\\\"") }}
keybind = ctrl+alt+shift+super+{{ $key }}={{ $text }}
command-palette-entry = title:"{{ .title | replace "\\" "\\\\" | replace "\"" "\\\"" }}",description:"{{ .description | replace "\\" "\\\\" | replace "\"" "\\\"" }}",action:"{{ $text | replace "\\" "\\\\" | replace "\"" "\\\"" }}"
{{- end }}
