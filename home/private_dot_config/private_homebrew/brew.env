# Homebrew >=6 enables "ask mode" by default, prompting for confirmation before
# install/upgrade/reinstall whenever it is attached to a TTY. Restore the old
# non-interactive behaviour.
#
# Setting it here rather than only in the shell rc means every brew invocation
# picks it up, not just interactive zsh. Note: this file supports neither shell
# variable expansion nor command substitution.
HOMEBREW_NO_ASK=1
