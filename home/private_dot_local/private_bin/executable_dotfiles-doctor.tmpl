{{- $machineClass := includeTemplate "machine-class" . | trim -}}
#! /usr/bin/env bash
{{ includeTemplate "scripts-library" . }}

# Post-bootstrap health check. Prints a checklist and exits non-zero if anything
# required is broken, so it is usable both by hand and in CI.
#
# Checks that cannot apply to this machine (GUI checks on a server, an optional
# tool that was never meant to be here) are reported as skipped, not failed:
# only genuine breakage should turn the exit code red.

MACHINE_CLASS={{ $machineClass | quote }}
TERMINAL_FONT={{ .terminalFont.name | quote }}
SIGNING_SSH_PROGRAM={{ .signing_ssh_program | default "" | quote }}

failures=0
warnings=0

function ok() {
  printf '  \033[1;32m✓\033[0m %s\n' "$*"
}

function fail() {
  printf '  \033[0;31m✗\033[0m %s\n' "$*"
  failures=$((failures + 1))
}

function warn_check() {
  printf '  \033[1;33m!\033[0m %s\n' "$*"
  warnings=$((warnings + 1))
}

function skip() {
  printf '  \033[0;90m-\033[0m %s\n' "$*"
}

function section() {
  printf '\n\033[1m%s\033[0m\n' "$*"
}

function check_command() {
  local name="$1"
  local label="${2:-$1}"

  if command -v "${name}" >/dev/null 2>&1; then
    ok "${label} ($(command -v "${name}"))"
    return 0
  fi

  fail "${label} is not on PATH"
  return 1
}

section "Profile"
ok "machine_class is ${MACHINE_CLASS}"
if [[ "$(basename "${SHELL:-}")" == "zsh" ]]; then
  ok "default shell is zsh"
else
  warn_check "default shell is ${SHELL:-unset}, expected zsh (chsh -s \"\$(command -v zsh)\")"
fi

section "chezmoi"
if check_command chezmoi; then
  if chezmoi verify >/dev/null 2>&1; then
    ok "no pending changes (chezmoi verify)"
  else
    warn_check "target state differs from source; review with: chezmoi diff"
  fi
fi

section "1Password"
if check_command op "1Password CLI"; then
  if [[ -n "$(op account list 2>/dev/null)" ]]; then
    ok "an account is configured"
    if op whoami >/dev/null 2>&1; then
      ok "session is unlocked (op whoami)"
    else
      warn_check "signed out; unlock with: eval \"\$(op signin)\""
    fi
  else
    fail "no account configured; run: op account add"
  fi
fi

if [[ "${MACHINE_CLASS}" != "desktop" ]]; then
  skip "desktop app not expected on a server"
{{- if eq .chezmoi.os "darwin" }}
elif [[ -d /Applications/1Password.app ]]; then
  ok "1Password desktop app is installed"
else
  fail "1Password desktop app is missing from /Applications"
{{- else }}
elif command -v 1password >/dev/null 2>&1; then
  ok "1Password desktop app is installed"
else
  fail "1Password desktop app is missing"
{{- end }}
fi

section "SSH and git signing"
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
  ok "SSH agent socket at ${SSH_AUTH_SOCK}"
  if ssh-add -l >/dev/null 2>&1; then
    ok "agent has keys loaded"
  else
    warn_check "agent has no keys; unlock 1Password or check its SSH agent setting"
  fi
else
  warn_check "SSH_AUTH_SOCK is unset or not a socket"
fi

if [[ -n "${SIGNING_SSH_PROGRAM}" ]]; then
  if [[ -x "${SIGNING_SSH_PROGRAM}" ]]; then
    ok "git signing helper at ${SIGNING_SSH_PROGRAM}"
  else
    fail "git signing helper missing at ${SIGNING_SSH_PROGRAM}"
  fi
else
  skip "no git signing helper configured for this OS"
fi

section "AI CLIs"
for tool in claude opencode codex; do
  check_command "${tool}" || true
done

section "Terminal and fonts"
if [[ "${MACHINE_CLASS}" == "desktop" ]]; then
{{- if eq .chezmoi.os "darwin" }}
  # These dotfiles only install Ghostty on Linux desktops, so on macOS a missing
  # app is a note rather than a broken bootstrap.
  if [[ -d /Applications/Ghostty.app ]]; then
    ok "Ghostty is installed"
  else
    skip "Ghostty is not installed (not bootstrapped on macOS)"
  fi
{{- else }}
  check_command ghostty Ghostty || true
{{- end }}

  if command -v fc-list >/dev/null 2>&1; then
    # --count, not --quiet: grep --quiet exits on the first match and SIGPIPEs
    # fc-list, which pipefail then reports as a failed check at random.
    if fc-list : family | grep --count --fixed-strings "${TERMINAL_FONT}" >/dev/null; then
      ok "${TERMINAL_FONT} is installed"
    else
      fail "${TERMINAL_FONT} is not visible to fontconfig"
    fi
  else
    skip "fontconfig not installed, cannot check fonts"
  fi
else
  skip "terminal emulator and fonts not expected on a server"
fi

section "GNOME settings"
if [[ "${MACHINE_CLASS}" != "desktop" ]]; then
  skip "not applicable on a server"
elif ! command -v dconf >/dev/null 2>&1; then
  skip "dconf not installed"
else
  gnome_dir="${HOME}/.config/dotfiles/gnome"
  present=0
  drifted=0
{{- range .gnome.settings }}
  if [[ -s "${gnome_dir}/{{ .file }}" ]]; then
    present=$((present + 1))
    # Compare the live values against the committed export rather than assuming
    # the load script ran: a later manual change should show up here.
    if ! diff --brief <(dconf dump {{ .path | quote }}) "${gnome_dir}/{{ .file }}" >/dev/null 2>&1; then
      drifted=$((drifted + 1))
      warn_check "{{ .path }} differs from {{ .file }}"
    fi
  fi
{{- end }}
  if ((present == 0)); then
    skip "no exported settings yet; create them with: gnome-settings-export"
  elif ((drifted == 0)); then
    ok "${present} exported group(s) match the live session"
  fi
fi

section "Summary"
if ((failures > 0)); then
  printf '  \033[0;31m%d failed\033[0m, %d warning(s)\n' "${failures}" "${warnings}"
  exit 1
fi

printf '  \033[1;32mall checks passed\033[0m, %d warning(s)\n' "${warnings}"
