{{- $machineClass := includeTemplate "machine-class" . | trim -}}
#! /usr/bin/env bash
{{ includeTemplate "scripts-library" . }}

# Post-bootstrap health check. Prints a checklist and exits non-zero if anything
# required is broken, so it is usable both by hand and in CI.
#
# Checks that cannot apply to this machine (GUI checks on a server, an optional
# tool that was never meant to be here) are reported as skipped, not failed:
# only genuine breakage should turn the exit code red.

MACHINE_CLASS={{ $machineClass | quote }}
TERMINAL_FONT={{ .terminalFont.name | quote }}
TERMINAL_FONT_POSTSCRIPT={{ .terminalFont.postScriptName | quote }}
TERMINAL_FONT_SIZE={{ .terminalFont.size | quote }}
SIGNING_SSH_PROGRAM={{ .signing_ssh_program | default "" | quote }}

failures=0
warnings=0

function ok() {
  printf '  \033[1;32m✓\033[0m %s\n' "$*"
}

function fail() {
  printf '  \033[0;31m✗\033[0m %s\n' "$*"
  failures=$((failures + 1))
}

function warn_check() {
  printf '  \033[1;33m!\033[0m %s\n' "$*"
  warnings=$((warnings + 1))
}

function skip() {
  printf '  \033[0;90m-\033[0m %s\n' "$*"
}

function section() {
  printf '\n\033[1m%s\033[0m\n' "$*"
}

function check_command() {
  local name="$1"
  local label="${2:-$1}"

  if command -v "${name}" >/dev/null 2>&1; then
    ok "${label} ($(command -v "${name}"))"
    return 0
  fi

  fail "${label} is not on PATH"
  return 1
}

section "Profile"
ok "machine_class is ${MACHINE_CLASS}"
if [[ "$(basename "${SHELL:-}")" == "zsh" ]]; then
  ok "default shell is zsh"
{{- if eq .chezmoi.os "linux" }}
elif ! grep -q "^$(id -un):" /etc/passwd 2>/dev/null; then
  # chsh only edits /etc/passwd, so telling a directory account (IPA/LDAP/AD) to
  # run it would be advice that cannot work.
  skip "login shell is ${SHELL:-unset}; $(id -un) has no /etc/passwd entry, so ~/.bashrc starts zsh instead"
{{- end }}
else
  warn_check "default shell is ${SHELL:-unset}, expected zsh (chsh -s \"\$(command -v zsh)\")"
fi

section "chezmoi"
if check_command chezmoi; then
  if chezmoi verify >/dev/null 2>&1; then
    ok "no pending changes (chezmoi verify)"
  else
    warn_check "target state differs from source; review with: chezmoi diff"
  fi
fi

section "1Password"
if check_command op "1Password CLI"; then
  if [[ -n "$(op account list 2>/dev/null)" ]]; then
    ok "an account is configured"
    if op whoami >/dev/null 2>&1; then
      ok "session is unlocked (op whoami)"
    else
      warn_check "signed out; unlock with: eval \"\$(op signin)\""
    fi
  else
    fail "no account configured; run: op account add"
  fi
fi

if [[ "${MACHINE_CLASS}" != "desktop" ]]; then
  skip "desktop app not expected on a server"
{{- if eq .chezmoi.os "darwin" }}
elif [[ -d /Applications/1Password.app ]]; then
  ok "1Password desktop app is installed"
else
  fail "1Password desktop app is missing from /Applications"
{{- else }}
elif command -v 1password >/dev/null 2>&1; then
  ok "1Password desktop app is installed"
else
  fail "1Password desktop app is missing"
{{- end }}
fi

section "SSH and git signing"
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
  ok "SSH agent socket at ${SSH_AUTH_SOCK}"
  if ssh-add -l >/dev/null 2>&1; then
    ok "agent has keys loaded"
  else
    warn_check "agent has no keys; unlock 1Password or check its SSH agent setting"
  fi
else
  warn_check "SSH_AUTH_SOCK is unset or not a socket"
fi

if [[ -n "${SIGNING_SSH_PROGRAM}" ]]; then
  if [[ -x "${SIGNING_SSH_PROGRAM}" ]]; then
    ok "git signing helper at ${SIGNING_SSH_PROGRAM}"
  else
    fail "git signing helper missing at ${SIGNING_SSH_PROGRAM}"
  fi
else
  skip "no git signing helper configured for this OS"
fi

section "AI CLIs"
for tool in claude opencode codex; do
  check_command "${tool}" || true
done

section "Terminal and fonts"
if [[ "${MACHINE_CLASS}" == "desktop" ]]; then
{{- if eq .chezmoi.os "darwin" }}
  # These dotfiles only install Ghostty on Linux desktops, so on macOS a missing
  # app is a note rather than a broken bootstrap.
  if [[ -d /Applications/Ghostty.app ]]; then
    ok "Ghostty is installed"
  else
    skip "Ghostty is not installed (not bootstrapped on macOS)"
  fi
{{- else }}
  check_command ghostty Ghostty || true
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
  # fc-list belongs to fontconfig, which stock macOS does not ship. This check
  # therefore reported "fontconfig not installed" on every Mac and verified
  # nothing at all. CoreText is the authority on macOS and built-in JXA reaches
  # it with no dependencies to install.
  font_resolved="$(osascript -l JavaScript \
    -e "ObjC.import('AppKit'); \$.NSFont.fontWithNameSize('${TERMINAL_FONT_POSTSCRIPT}', ${TERMINAL_FONT_SIZE}).isNil() ? 'missing' : 'found'" \
    2>/dev/null || true)"
  if [[ "${font_resolved}" == "found" ]]; then
    ok "${TERMINAL_FONT_POSTSCRIPT} resolves through CoreText"
  else
    fail "${TERMINAL_FONT_POSTSCRIPT} does not resolve; check ~/Library/Fonts"
  fi

  # Installed is not the same as configured. Ghostty, WezTerm, Alacritty, Hyper
  # and Zellij read a chezmoi-managed file and cannot drift. These two keep their
  # font in preferences, so they are the only ones that can quietly fall behind
  # .chezmoidata/fonts.yaml -- which is the whole reason this check exists.
  #
  # The font is an NSKeyedArchiver blob, and the PostScript name survives inside
  # it as readable text. openssl rather than base64, and tr rather than strings:
  # base64's decode flag differs between the BSD and GNU builds, and strings
  # comes from the Xcode command line tools, which need not be installed.
  terminal_profile="$(defaults read com.apple.Terminal "Default Window Settings" 2>/dev/null || true)"
  if [[ -z "${terminal_profile}" ]]; then
    skip "Terminal.app has no default profile set yet"
  else
    terminal_font="$(defaults export com.apple.Terminal - 2>/dev/null |
      plutil -extract "Window Settings.${terminal_profile}.Font" raw -o - - 2>/dev/null |
      openssl base64 -d -A 2>/dev/null | tr -cd '[:print:]' || true)"
    if [[ "${terminal_font}" == *"${TERMINAL_FONT_POSTSCRIPT}"* ]]; then
      ok "Terminal.app profile '${terminal_profile}' uses ${TERMINAL_FONT_POSTSCRIPT}"
    else
      warn_check "Terminal.app profile '${terminal_profile}' is not using ${TERMINAL_FONT_POSTSCRIPT}; quit Terminal.app and run 'chezmoi apply'"
    fi
  fi

  if [[ ! -d /Applications/iTerm.app ]]; then
    skip "iTerm2 is not installed"
  else
    iterm_profile="${HOME}/Library/Application Support/iTerm2/DynamicProfiles/dotfiles.json"
    if [[ ! -f "${iterm_profile}" ]]; then
      warn_check "the iTerm2 dotfiles profile is not installed; run 'chezmoi apply'"
    elif iterm_font="$(plutil -extract 'Profiles.0.Normal Font' raw -o - "${iterm_profile}" 2>/dev/null || true)" &&
      [[ "${iterm_font}" == "${TERMINAL_FONT_POSTSCRIPT} ${TERMINAL_FONT_SIZE}" ]]; then
      ok "the iTerm2 dotfiles profile uses ${TERMINAL_FONT_POSTSCRIPT} at ${TERMINAL_FONT_SIZE}pt"
    else
      warn_check "the iTerm2 dotfiles profile says '${iterm_font}', not '${TERMINAL_FONT_POSTSCRIPT} ${TERMINAL_FONT_SIZE}'; run 'chezmoi apply'"
    fi
  fi
{{- else }}
  if command -v fc-list >/dev/null 2>&1; then
    # --count, not --quiet: grep --quiet exits on the first match and SIGPIPEs
    # fc-list, which pipefail then reports as a failed check at random.
    if fc-list : family | grep --count --fixed-strings "${TERMINAL_FONT}" >/dev/null; then
      ok "${TERMINAL_FONT} is installed"
    else
      fail "${TERMINAL_FONT} is not visible to fontconfig"
    fi
  else
    skip "fontconfig not installed, cannot check fonts"
  fi

  # Installed is not the same as configured. GNOME Terminal keeps its font in
  # dconf rather than in a file this repo renders, so it is the Linux counterpart
  # of the Terminal.app check and the only one here that can drift.
  if ! command -v dconf >/dev/null 2>&1; then
    skip "dconf not installed, cannot check the GNOME Terminal font"
  else
    gnome_profiles="$(dconf read '/org/gnome/terminal/legacy/profiles:/list' 2>/dev/null || true)"
    gnome_profiles="$(printf '%s' "${gnome_profiles}" | tr -d "[]' ")"
    if [[ -z "${gnome_profiles}" ]]; then
      skip "GNOME Terminal has no profiles yet"
    else
      gnome_drift=0
      gnome_checked=0
      IFS=',' read -r -a gnome_profile_ids <<< "${gnome_profiles}"
      for gnome_profile_id in "${gnome_profile_ids[@]}"; do
        [[ -n "${gnome_profile_id}" ]] || continue
        gnome_configured="$(dconf read "/org/gnome/terminal/legacy/profiles:/:${gnome_profile_id}/font" 2>/dev/null | tr -d "'" || true)"
        gnome_system_font="$(dconf read "/org/gnome/terminal/legacy/profiles:/:${gnome_profile_id}/use-system-font" 2>/dev/null || true)"
        gnome_checked=$((gnome_checked + 1))
        # use-system-font has to be checked too, not just the font string: a
        # profile inheriting the system font ignores its own font key, so the
        # right value there still renders the wrong font.
        if [[ "${gnome_configured}" != "${TERMINAL_FONT} ${TERMINAL_FONT_SIZE}" ||
          "${gnome_system_font}" == "true" ]]; then
          gnome_drift=$((gnome_drift + 1))
        fi
      done
      if ((gnome_drift == 0)); then
        ok "all ${gnome_checked} GNOME Terminal profile(s) use ${TERMINAL_FONT} ${TERMINAL_FONT_SIZE}"
      else
        warn_check "${gnome_drift} of ${gnome_checked} GNOME Terminal profile(s) are not using ${TERMINAL_FONT} ${TERMINAL_FONT_SIZE}; run 'chezmoi apply'"
      fi
    fi
  fi
{{- end }}
else
  skip "terminal emulator and fonts not expected on a server"
fi

section "GNOME settings"
if [[ "${MACHINE_CLASS}" != "desktop" ]]; then
  skip "not applicable on a server"
elif ! command -v dconf >/dev/null 2>&1; then
  skip "dconf not installed"
else
  gnome_dir="${HOME}/.config/dotfiles/gnome"
  present=0
  drifted=0
{{- range .gnome.settings }}
  if [[ -s "${gnome_dir}/{{ .file }}" ]]; then
    present=$((present + 1))
    # Compare the live values against the committed export rather than assuming
    # the load script ran: a later manual change should show up here.
    if ! diff --brief <(dconf dump {{ .path | quote }}) "${gnome_dir}/{{ .file }}" >/dev/null 2>&1; then
      drifted=$((drifted + 1))
      warn_check "{{ .path }} differs from {{ .file }}"
    fi
  fi
{{- end }}
  if ((present == 0)); then
    skip "no exported settings yet; create them with: gnome-settings-export"
  elif ((drifted == 0)); then
    ok "${present} exported group(s) match the live session"
  fi
fi

section "Summary"
if ((failures > 0)); then
  printf '  \033[0;31m%d failed\033[0m, %d warning(s)\n' "${failures}" "${warnings}"
  exit 1
fi

printf '  \033[1;32mall checks passed\033[0m, %d warning(s)\n' "${warnings}"
