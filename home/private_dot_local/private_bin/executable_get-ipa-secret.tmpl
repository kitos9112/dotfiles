#!/usr/bin/env bash
{{ includeTemplate "scripts-library" . }}
{{ includeTemplate "freeipa-library" . }}
# get-ipa-secret — read a secret out of a FreeIPA vault, decoded, on stdout
# Usage:
#   get-ipa-secret [ipa vault-retrieve options...] <vault_key>

{{ if eq .chezmoi.os "darwin" -}}
readonly BASE64_DECODE="-D" # BSD base64 on macOS
{{- else -}}
readonly BASE64_DECODE="-d" # GNU coreutils base64
{{- end }}

usage() {
  cat <<'USAGE'
Usage: get-ipa-secret [ipa vault-retrieve options...] <vault_key>
  -h, --help  Show help

Every other argument is forwarded verbatim to `ipa vault-retrieve`, so the vault
selectors it already understands keep working without being duplicated here:

  get-ipa-secret my_key                                  # private vault
  get-ipa-secret --shared my_key                         # shared vault
  get-ipa-secret --service HTTP/host.example.com my_key  # service vault

Notes:
- Requires a valid Kerberos ticket; get one with get-krb-ticket.sh.
- The decoded secret goes to stdout with no trailing newline, so
  `secret="$(get-ipa-secret my_key)"` captures it byte for byte. Running it
  without redirecting leaves the secret in your terminal scrollback.
USAGE
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac

if (($# == 0)); then
  usage >&2
  usage_error "a vault key is required"
fi

require_commands ipa awk base64
require_krb_ticket

# A failing `ipa` is caught by pipefail; awk just finds nothing to print. The
# empty check is what turns a failed retrieval into a non-zero exit instead of an
# empty string that looks like a valid secret.
secret_base64="$(ipa vault-retrieve "$@" | awk '/Data:/ { print $2 }')"
if [[ -z "${secret_base64}" ]]; then
  error "no secret data returned by 'ipa vault-retrieve $*'"
fi

printf '%s' "${secret_base64}" | base64 "${BASE64_DECODE}"
