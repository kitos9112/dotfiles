#!/usr/bin/env bash
set -euo pipefail
umask 077

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'EOF'
Usage: backup-agent-state --check | --quiesced [--send] | --scheduled

--check      Check local configuration, dependencies and the 1Password identity.
--quiesced   Back up and verify Claude and Codex after you have stopped all writers.
--send       Also transfer both verified archives to the configured SCP destination.
--scheduled  Back up from copy-on-write snapshots while the agents keep running,
             without 1Password, then keep only the newest KEEP_RUNS runs.
             Archives are checked for an age header, not decrypted; run
             --quiesced now and then for a full verification.

Configuration: ${XDG_CONFIG_HOME:-$HOME/.config}/agent-state-backup.env (mode 0600)
Override its path with AGENT_BACKUP_CONFIG. No backup runs without --quiesced
or --scheduled.

Required: BACKUP_RECIPIENT BACKUP_ROOT CLAUDE_SOURCE CODEX_SOURCE, plus OP_VAULT
and OP_ITEM_ID except with --scheduled. Optional: GNUPG_SOURCE, KEEP_RUNS
(default 7), and CLAUDE_EXCLUDES, CODEX_EXCLUDES or GNUPG_EXCLUDES, each a
space-separated list of paths relative to its source that replaces the default.
EOF
}

DEFAULT_CLAUDE_EXCLUDES='plugins cache shell-snapshots session-env debug ide paste-cache statsig telemetry'
DEFAULT_CODEX_EXCLUDES='worktrees plugins packages .tmp tmp cache computer-use vendor_imports log shell_snapshots ipc thread-writer-locks logs_2.sqlite logs_2.sqlite-shm logs_2.sqlite-wal'
DEFAULT_GNUPG_EXCLUDES=''

CHECK=0
SEND=0
SCHEDULED=0
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --check) [[ $# == 1 ]] || { usage >&2; exit 2; }; CHECK=1 ;;
  --scheduled) [[ $# == 1 ]] || { usage >&2; exit 2; }; SCHEDULED=1 ;;
  --quiesced)
    if [[ $# == 2 && "$2" == --send ]]; then SEND=1
    elif [[ $# != 1 ]]; then usage >&2; exit 2
    fi
    ;;
  *) usage >&2; exit 2 ;;
esac

CONFIG="${AGENT_BACKUP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/agent-state-backup.env}"
[[ -f "$CONFIG" && ! -L "$CONFIG" && -O "$CONFIG" ]] || die "configuration must be an owned regular file: $CONFIG"
mode="$(stat -c %a -- "$CONFIG" 2>/dev/null || stat -f %Lp "$CONFIG")"
[[ "$mode" == 600 ]] || die "configuration must have mode 0600: $CONFIG"
# shellcheck source=/dev/null
source "$CONFIG"
if [[ -n "${OP_ACCOUNT:-}" ]]; then
  export OP_ACCOUNT
fi
required=(BACKUP_RECIPIENT BACKUP_ROOT CLAUDE_SOURCE CODEX_SOURCE)
[[ "$SCHEDULED" == 1 ]] || required+=(OP_VAULT OP_ITEM_ID)
for setting in "${required[@]}"; do
  [[ -n "${!setting:-}" ]] || die "missing configuration: $setting"
done
KEEP_RUNS="${KEEP_RUNS:-7}"
[[ "$KEEP_RUNS" =~ ^[1-9][0-9]*$ ]] || die 'KEEP_RUNS must be a positive integer'
if [[ "$SEND" == 1 ]]; then
  [[ -n "${SCP_HOST:-}" && -n "${SCP_DIRECTORY:-}" ]] || die 'configure SCP_HOST and SCP_DIRECTORY before using --send'
fi
dependencies=(age zstd)
[[ "$SCHEDULED" == 1 ]] || dependencies+=(age-keygen op)
for dependency in "${dependencies[@]}"; do
  command -v "$dependency" >/dev/null || die "missing dependency: $dependency"
done
tar_bin="$(command -v gtar || command -v tar)"
link_bin="$(command -v gln || command -v ln)"
[[ "$("$tar_bin" --version 2>/dev/null)" == *'GNU tar'* ]] || die 'GNU tar is required'
[[ "$("$link_bin" --version 2>/dev/null)" == *'GNU coreutils'* ]] || die 'GNU ln is required'
UTILITY="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/encrypted-directory-backup"
[[ -x "$UTILITY" ]] || die 'install encrypted-directory-backup alongside this launcher'

agents=(claude codex)
[[ -z "${GNUPG_SOURCE:-}" ]] || agents+=(gnupg)
source_for() {
  case "$1" in
    claude) printf '%s\n' "$CLAUDE_SOURCE" ;;
    codex) printf '%s\n' "$CODEX_SOURCE" ;;
    gnupg) printf '%s\n' "$GNUPG_SOURCE" ;;
  esac
}
excludes_for() {
  case "$1" in
    claude) printf '%s\n' "${CLAUDE_EXCLUDES-$DEFAULT_CLAUDE_EXCLUDES}" ;;
    codex) printf '%s\n' "${CODEX_EXCLUDES-$DEFAULT_CODEX_EXCLUDES}" ;;
    gnupg) printf '%s\n' "${GNUPG_EXCLUDES-$DEFAULT_GNUPG_EXCLUDES}" ;;
  esac
}
for agent in "${agents[@]}"; do
  source_dir="$(source_for "$agent")"
  [[ -d "$source_dir" && ! -L "${source_dir%/}" ]] || die "source must be an existing directory, not a symlink: $source_dir"
done
if [[ "$SCHEDULED" == 0 ]]; then
  if ! vault_recipient="$(op document get "$OP_ITEM_ID" --vault "$OP_VAULT" 2>/dev/null | age-keygen -y 2>/dev/null)"; then
    die 'cannot retrieve the identity; unlock 1Password and check op whoami'
  fi
  [[ "$vault_recipient" == "$BACKUP_RECIPIENT" ]] || die 'configured recipient does not match the identity in 1Password'
fi
if [[ "$CHECK" == 1 ]]; then
  printf 'Configuration, dependencies and vault identity verified. No backup created.\n'
  exit 0
fi

mkdir -p -- "$BACKUP_ROOT"
run_dir="$(mktemp -d "$BACKUP_ROOT/$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")"
if [[ "$SCHEDULED" == 1 ]]; then
  trap 'rm -rf -- "$run_dir"' EXIT
  capture=--snapshot
else
  printf 'Run directory (retained on failure): %s\n' "$run_dir"
  capture=--quiesced
fi
for agent in "${agents[@]}"; do
  archive="$run_dir/$agent.tar.zst.age"
  exclude_args=()
  read -r -a agent_excludes <<<"$(excludes_for "$agent")"
  for rel in ${agent_excludes[@]+"${agent_excludes[@]}"}; do
    exclude_args+=(--exclude "$rel")
  done
  "$UTILITY" create "$(source_for "$agent")" "$archive" "$BACKUP_RECIPIENT" "$capture" ${exclude_args[@]+"${exclude_args[@]}"}
  if [[ "$SCHEDULED" == 1 ]]; then
    IFS= read -r header <"$archive" || die "archive is empty: $archive"
    [[ "$header" == age-encryption.org/v1 ]] || die "archive lacks an age header: $archive"
  else
    "$UTILITY" verify "$archive" "$OP_VAULT" "$OP_ITEM_ID"
  fi
done

if [[ "$SCHEDULED" == 1 ]]; then
  trap - EXIT
  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*T[0-9]*Z.??????' -print |
    LC_ALL=C sort -r | tail -n +"$((KEEP_RUNS + 1))" |
    while IFS= read -r old_run; do
      rm -rf -- "$old_run"
    done
  printf 'Scheduled backup complete: %s\n' "$run_dir"
  exit 0
fi

printf 'All archives verified: %s\n' "$run_dir"
if [[ "$SEND" == 1 ]]; then
  for agent in "${agents[@]}"; do
    "$UTILITY" send "$run_dir/$agent.tar.zst.age" "$SCP_HOST" "$SCP_DIRECTORY"
  done
fi
