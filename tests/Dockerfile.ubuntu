# checkov:skip=CKV_DOCKER_7: base image tag is supplied by the CI matrix via BASE_IMAGE
# checkov:skip=CKV_DOCKER_2: smoke-test image, never run as a long-lived container
# checkov:skip=CKV2_DOCKER_1: sudo is part of the dotfiles bootstrap under test
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# ca-certificates is listed explicitly because --no-install-recommends drops it,
# and without a CA bundle curl cannot fetch the chezmoi installer over HTTPS.
# jq is explicit because this smoke run excludes the package-install scripts,
# while the managed Claude settings modifier still needs it.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    file \
    git \
    iproute2 \
    jq \
    sudo && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/sh -d /home/docker-qa docker-qa && \
    echo "docker-qa ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER docker-qa

COPY --chown=docker-qa:docker-qa ./ /home/docker-qa/.dotfiles

WORKDIR /home/docker-qa

# A container has no GUI, so pin the server profile rather than relying on
# auto-detection: that is also the path a real headless bootstrap takes.
RUN DOTFILES_TEST=true DOTFILES_VERBOSE=true DOTFILES_NO_TTY=true \
    DOTFILES_PROFILE=server DOTFILES_CHEZMOI_EXCLUDE=scripts .dotfiles/install
